# MjengoOS — scheduled backup (the service half of the systemd timer
# pair; mjengo-backup.timer owns the cadence). Issue #199 / audit INF-7.
#
# Runs deploy/backup/mjengo-backup.sh (installed at /usr/local/bin):
# an ONLINE sqlite3 `.backup` snapshot of the app database (WAL-safe,
# no app stop), tar+gzip of the app-photos and website-data volumes
# (+ optional app-docs), a sha256 sidecar per artifact, an
# integrity_check on the fresh DB snapshot, and 7-daily/4-weekly
# retention pruning. Any failure = non-zero exit + one stderr line →
# a FAILED unit → visible in `journalctl -u mjengo-backup.service`,
# so an uptime monitor can dead-man-switch it.
# Full story + the RESTORE runbook: DEPLOYMENT.md §7.2.
#
# Least privilege (same posture as mjengo-jobs.service, issue #197):
# the unit runs as the dedicated `mjengo` system user under a full
# sandboxing block — never root. Unlike the jobs unit (which writes
# nothing), this one WRITES, but to exactly one place:
# ReadWritePaths= below is the only writable location and must match
# MJENGO_BACKUP_DIR in /etc/mjengo/backup.env (change both or neither).
# Reading the sources needs no extra grants on a bare-metal install
# (the app itself runs as mjengo — DEPLOYMENT.md §7). On docker
# compose the volume files are owned by the container's `node` user;
# grant the backup user read access once with setfacl — the exact
# commands are in mjengo-backup.env.example. Dev-box note: sources
# under /home are invisible to this unit (ProtectHome=true) — run the
# script manually there instead of via the timer, or relax
# ProtectHome deliberately.
#
# INSTALL (root, from a repo checkout):
#   # once per host — the dedicated, no-login service user (skip if the
#   # jobs pair already created it):
#   useradd --system --user-group --home-dir /nonexistent \
#          --shell /usr/sbin/nologin mjengo
#   install -D -m 0755 deploy/backup/mjengo-backup.sh  /usr/local/bin/mjengo-backup.sh
#   install -D -m 0644 deploy/backup/mjengo-backup.service /etc/systemd/system/
#   install -D -m 0644 deploy/backup/mjengo-backup.timer   /etc/systemd/system/
#   install -D -m 0644 deploy/backup/mjengo-backup.env.example /etc/mjengo/backup.env
#   install -d -o mjengo -g mjengo -m 0700 /var/backups/mjengo
#   # edit /etc/mjengo/backup.env: set the three source paths for YOUR
#   # deployment (docker volume mountpoints or bare-metal dirs), then:
#   systemctl daemon-reload
#   systemctl enable --now mjengo-backup.timer    # the TIMER, not the service
#   # first run by hand to verify the whole chain (writes real backups):
#   systemctl start mjengo-backup.service
#
# Verify:  systemctl list-timers 'mjengo-backup*'
#          journalctl -u mjengo-backup.service    # each run's artifact list
#          ls -l /var/backups/mjengo/daily/ /var/backups/mjengo/weekly/

[Unit]
Description=MjengoOS scheduled backup (online SQLite snapshot + volume tars)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
# Dedicated system user (see the INSTALL header) — the unit never needs
# root: it only READS the app's data and writes the backup dir.
User=mjengo
Group=mjengo
# Paths + retention + opt-outs (+ the optional dead-man ping URL, issue
# #217). Secret-free by default — 0644 root:root is fine — EXCEPT when
# BACKUP_HEALTHCHECK_URL is set (it is a bearer capability: anyone holding
# it can forge "backup ok" pings): then tighten the file to 0600 root:root.
# The systemd manager reads EnvironmentFile= either way.
EnvironmentFile=/etc/mjengo/backup.env
SyslogIdentifier=mjengo-backup
# Generous on purpose: a big photos volume tars slowly, and an online
# .backup against a busy writer can restart its copy pass. A failure
# still ends the unit non-zero (the script's contract).
TimeoutStartSec=2h
ExecStart=/usr/local/bin/mjengo-backup.sh

# ---- Sandboxing (same family as mjengo-jobs.service, issue #197) -----
# The ONE difference from the jobs unit: this unit writes —
# ReadWritePaths= pins writes to the backup dir ONLY (must equal
# MJENGO_BACKUP_DIR in the env file). Everything else is read-only:
# docker volume mountpoints under /var/lib/docker stay READABLE under
# ProtectSystem=strict (read-only ≠ invisible), so a compromised backup
# run cannot modify app data. Network: AF_INET/AF_INET6 are permitted for
# the OPTIONAL dead-man ping only (issue #217 — BACKUP_HEALTHCHECK_URL in
# the env file; with it unset the script never curls and this unit still
# opens no sockets — the restriction exists so the ping is possible, not
# so the unit chats). Everything else about the sandbox is unchanged.
ReadWritePaths=/var/backups/mjengo
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @swap @obsolete
SystemCallArchitectures=native
RemoveIPC=true
UMask=0077
