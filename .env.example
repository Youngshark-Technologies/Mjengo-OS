# MJG-019 — MjengoOS environment template. Copy to .env and adjust.
# SQLite file location (create/keep the directory writable by the app user).
DATABASE_URL=file:/home/z/my-project/db/custom.db
# Port for the standalone production server (also read by docker-entrypoint).
PORT=3000

# MJG-027 — hosted split deployment (docs/DEPLOYMENT.md §Hosted deployment).
# FRONTEND (Vercel): set to the Render backend base URL, e.g. https://mjengoos-api.onrender.com
#   → /api/* is proxied there (same-origin cookies preserved, no CORS needed).
# Leave unset when the API runs in the same process (local dev, Docker, Render).
BACKEND_URL=
# MJG-028 — public app origin used by the marketing CTAs (Get Started / Sign in).
# Set to the app URL, e.g. https://mjengoupdate.vercel.app → CTAs navigate there
# and open auth via /#get-started. Leave empty for the default in-page auth view.
NEXT_PUBLIC_APP_URL=
