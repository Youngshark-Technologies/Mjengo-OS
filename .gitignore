# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# OS / IDE / editor junk (S-SEC hygiene)
Thumbs.db
.idea/
.vscode/
*.swp
*~

# tool caches
.eslintcache
.stylelintcache
.turbo

# stray database files outside the ignored db/ dir (prisma scratch DBs)
*.db
*.sqlite
*.sqlite3

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# (.env.staging.example is the staging compose template — issue #208; the
#  real .env.staging stays ignored like every other .env*)
.env*
!.env.example
!.env.staging.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
/local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log

server.log
# Skills directory
/skills/

# ── repository hygiene: local-only files & folders (never push) ──────────────
# environment & database (runtime state, secrets)
.env
db/

# internal working documents & agent artifacts
# (root-anchored: the unanchored `upload/` also matched src/app/api/upload/ —
#  F-INSIGHT's route would have been silently untracked)
worklog.md
PENDING_FEATURES.md
agent-ctx/
tool-results/
.zscripts/
/upload/
/download/
/mini-services/
Caddyfile

# runtime photo uploads (POST /api/upload writes here — not repo content)
/public/photos/upp-*

# sandbox-only docs (local reports/notes — published docs like docs/screenshots stay tracked)
docs/reports/
docs/*.local.md

# sandbox environment scripts & template demos
# (tests/ was previously ignored as sandbox scratch — it now holds the real
#  Vitest suite tracked on feat/test-suite; keep it commited)
examples/
*.pid

# marketing-site runtime data (form submissions are local-only)
mjengoos-website/data/submissions.json